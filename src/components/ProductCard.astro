---
import type { Producto } from "../data/productos";
import { formatoPrecio } from "../data/productos";
import { waLink } from "../data/config";

interface Props {
  producto: Producto;
}
const { producto } = Astro.props;

const href = `/vestidos/${producto.id}`;
const mensaje = `¡Hola Princesitas! 👑 Me interesa el "${producto.nombre}" (${formatoPrecio(
  producto.precio
)}). ¿Está disponible?`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-[0_10px_30px_-18px_rgba(74,59,63,0.3)] ring-1 ring-secondary/40 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-card"
>
  <a href={href} class="relative block aspect-[3/4] overflow-hidden bg-secondary-light" aria-label={`Ver ${producto.nombre}`}>
    <img
      src={producto.imagen}
      alt={producto.nombre}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />

    <div class="absolute left-3 top-3 flex flex-col gap-2">
      {producto.nuevo && (
        <span class="rounded-full bg-tertiary px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-wider text-white shadow-sm">
          Nuevo
        </span>
      )}
      {producto.destacado && (
        <span class="rounded-full bg-primary px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-wider text-white shadow-sm">
          Destacado
        </span>
      )}
      {producto.video && (
        <span class="inline-flex items-center gap-1 rounded-full bg-white/90 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-wider text-ink shadow-sm backdrop-blur">
          ▶ Video
        </span>
      )}
    </div>

    <span
      class="absolute bottom-3 right-3 grid h-10 w-10 translate-y-2 place-items-center rounded-full bg-white/95 text-primary opacity-0 shadow-md backdrop-blur transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
      aria-hidden="true"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </span>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <span class="text-xs font-semibold uppercase tracking-widest text-tertiary">
      {producto.colores[0]?.nombre ?? ""}
    </span>
    <h3 class="mt-1.5 font-display text-lg font-bold leading-snug text-ink">
      <a href={href} class="transition-colors hover:text-primary">{producto.nombre}</a>
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink/70">
      {producto.descripcion}
    </p>

    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        producto.tallas.map((talla) => (
          <span class="rounded-full border border-secondary bg-neutral px-2.5 py-0.5 text-xs font-medium text-ink/70">
            T{talla}
          </span>
        ))
      }
    </div>

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-secondary/40 pt-4">
      <span class="font-display text-xl font-bold text-primary">
        {formatoPrecio(producto.precio)}
      </span>
      <div class="flex items-center gap-2">
        <a
          href={waLink(mensaje)}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#25D366]/12 text-[#1da851] transition-colors hover:bg-[#25D366] hover:text-white"
          aria-label={`Consultar por WhatsApp: ${producto.nombre}`}
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.09c-.25.69-1.45 1.32-2 1.4-.51.08-1.16.11-1.87-.12-.43-.14-.98-.32-1.69-.62-2.98-1.29-4.92-4.29-5.07-4.49-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.18 1.04-2.48.27-.3.59-.37.79-.37.2 0 .39 0 .56.01.18.01.42-.07.66.5.25.6.84 2.06.92 2.21.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.65-.07.17-.2.75-.87.94-1.17.2-.3.39-.25.66-.15.27.1 1.72.81 2.01.96.3.15.5.22.57.35.07.12.07.72-.18 1.41z" />
          </svg>
        </a>
        <a href={href} class="btn-primary !px-4 !py-2.5 text-xs">
          Ver más
        </a>
      </div>
    </div>
  </div>
</article>
